{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(npm install:*)",
      "Bash(flutter pub add:*)",
      "Bash(go get:*)",
      "Bash(pip install:*)"
    ]
  }
}
